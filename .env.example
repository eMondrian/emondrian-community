ENABLE_SERVICE_EMONDRIAN=true
ENABLE_SERVICE_OLAP_CLIENT=true
ENABLE_SERVICE_SCHEMA_EDITOR=true
ENABLE_SERVICE_CATALOG_EDITOR=true
# MCP endpoint for AI agents at /emondrian/mcp/sse. It has no authentication; set false to turn it off.
ENABLE_SERVICE_MCP=true

# Host port for the web front door. Change it if something else uses port 80.
EMONDRIAN_PORT=80

# Origin allowed to call /xmla and /api from a browser: * (default), one origin such as
# https://app.example.com, or empty to leave CORS to the eMondrian server.
CORS_ALLOW_ORIGIN=*
