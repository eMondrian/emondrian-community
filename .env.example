# Services behind the web front door: true to turn one on, anything else to turn it off.
# eMondrian server: /xmla, /api and /logs
ENABLE_SERVICE_EMONDRIAN=true
# OLAP Client at /client/ (an older .env may still use ENABLE_SERVICE_WEB_OLAP_CLIENT)
ENABLE_SERVICE_OLAP_CLIENT=true
# Schema Editor at /schema-editor/
ENABLE_SERVICE_SCHEMA_EDITOR=true
# Catalog Editor at /catalog-editor/ (follows ENABLE_SERVICE_SCHEMA_EDITOR when left out)
ENABLE_SERVICE_CATALOG_EDITOR=true
# MCP endpoint for AI agents at /emondrian/mcp (SSE at /emondrian/mcp/sse). It has no authentication and its
# save_schema tool overwrites schemas; set false to turn it off.
ENABLE_SERVICE_MCP=true
# Dashboards at /dashboard/, built by an AI agent through MCP. No authentication either:
# anyone who reaches the port sees every dashboard. Set false to turn it off.
ENABLE_SERVICE_DASHBOARD=true

# Host port for the web front door. Change it if something else uses port 80.
EMONDRIAN_PORT=80

# Origin allowed to call /xmla and /api from a browser: * (any origin), one origin such as
# https://app.example.com, or empty to leave CORS to the eMondrian server.
CORS_ALLOW_ORIGIN=*

# Credentials of your own data sources, for the eMondrian server only. A catalog's connect string
# names them as ${env:EMONDRIAN_SRC_SALES_PASSWORD}; the value is read when a connection opens and
# never appears in datasources.xml or in an MCP answer. Restart the eMondrian service after a change.
#EMONDRIAN_SRC_SALES_USER=
#EMONDRIAN_SRC_SALES_PASSWORD=
#EMONDRIAN_SRC_LAKE_TOKEN=

# Passwords of the two ClickHouse users synthetic catalogs work as (syn_writer, syn_reader).
# setup.sh fills them in with random values when they are empty; you never need to type them.
EMONDRIAN_SYN_WRITER_PASSWORD=
EMONDRIAN_SYN_READER_PASSWORD=

# Administrative rights: who may read or edit schemas, read or change the catalog registry
# (datasources.xml), read logs, install licence keys, and run a request as another user (XML/A
# EffectiveUserName, as the Power BI gateway does). Out of the box nothing is set, so there are no
# users and no roles and everybody may do everything.
#
# Each right is a -Dmondrian.security.<right>=<roles> option on JAVA_TOOL_OPTIONS, the roles
# separated by commas. A role is the caller's user name or one of their groups. A right with no
# option is open to everyone; a right with an option goes only to the roles listed, and an empty
# value (-Dmondrian.security.logs.read=) gives it to nobody. impersonate.allow is the exception:
# nobody holds it unless listed. schema.write includes schema.read, database.manage includes
# database.read. A caller named in no option holds mondrian.security.defaultRole. A misspelled
# mondrian.security.* key denies every right and is logged as an ERROR.
#
# JAVA_TOOL_OPTIONS is one line: put every -D option on it, these and any other (such as
# -Demondrian.mcp.agentAccess=synthetic-only). Then run docker compose up -d --force-recreate eMondrian.
#JAVA_TOOL_OPTIONS=-Dmondrian.security.defaultRole=admin -Dmondrian.security.schema.read=admin -Dmondrian.security.schema.write=admin -Dmondrian.security.database.read=admin -Dmondrian.security.database.manage=admin -Dmondrian.security.logs.read=admin -Dmondrian.security.license.manage=admin -Dmondrian.security.impersonate.allow=
