# Services behind the web front door: true to turn one on, anything else to turn it off.
# eMondrian server: /xmla, /api and /logs
ENABLE_SERVICE_EMONDRIAN=true
# OLAP Client at /client/ (an older .env may still use ENABLE_SERVICE_WEB_OLAP_CLIENT)
ENABLE_SERVICE_OLAP_CLIENT=true
# Schema Editor at /schema-editor/
ENABLE_SERVICE_SCHEMA_EDITOR=true
# Catalog Editor at /catalog-editor/ (follows ENABLE_SERVICE_SCHEMA_EDITOR when left out)
ENABLE_SERVICE_CATALOG_EDITOR=true
# MCP endpoint for AI agents at /emondrian/mcp/sse. It has no authentication and its
# save_schema tool overwrites schemas; set false to turn it off.
ENABLE_SERVICE_MCP=true

# Host port for the web front door. Change it if something else uses port 80.
EMONDRIAN_PORT=80

# Origin allowed to call /xmla and /api from a browser: * (any origin), one origin such as
# https://app.example.com, or empty to leave CORS to the eMondrian server.
CORS_ALLOW_ORIGIN=*
