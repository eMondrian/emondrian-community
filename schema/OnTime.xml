<?xml version="1.0" encoding="UTF-8"?>
<Schema name="OnTime">

  <!-- estimatedCount / approxRowCount: member counts measured against the full ontime table
       (182,315,946 rows) on 2026-10-14, not guesses. Without them Mondrian issues
       "select count(*) from (select distinct &lt;level keys&gt;)" per level, once per schema
       load and again after every member-cache flush, and MDSCHEMA_LEVELS plus
       CHILDREN_CARDINALITY make it materialize a whole level just to size it.

       An attribute's estimatedCount is distinct over its own key column. A Hierarchy Level's
       approxRowCount is what the engine itself counts: the level key plus every ancestor key
       up to and including the first unique one (SqlMemberSource.makeLevelMemberCountSql),
       which is why Quarter is 116 and not 4.

       These are estimates and may go stale, which is safe in one direction only. Too high
       keeps Mondrian constraining member queries and keeps Aggregation.optimizePredicates
       from dropping a constraint it believes covers a whole level; too low invites both. The
       community quick start ships one month of data, so on that stack every number here is an
       overestimate, which is the deliberate side to err on. -->


  <View alias="dim_airline">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT Reporting_Airline
      FROM ontime
      GROUP BY Reporting_Airline
    ]]></SQL>
  </View>

  <View alias="dim_time">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT
        Year * 100 + Month AS YearMonth,
        Year,
        Quarter,
        Month,
        concat('Q', toString(Quarter)) AS QuarterName,
        CASE Month
          WHEN 1  THEN 'January'    WHEN 2  THEN 'February'  WHEN 3  THEN 'March'
          WHEN 4  THEN 'April'      WHEN 5  THEN 'May'       WHEN 6  THEN 'June'
          WHEN 7  THEN 'July'       WHEN 8  THEN 'August'    WHEN 9  THEN 'September'
          WHEN 10 THEN 'October'    WHEN 11 THEN 'November'  WHEN 12 THEN 'December'
        END AS MonthName
      FROM ontime
      GROUP BY Year, Quarter, Month
    ]]></SQL>
  </View>

  <View alias="dim_day_of_week">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT
        DayOfWeek AS DayOfWeekKey,
        CASE DayOfWeek
          WHEN 1 THEN 'Monday'    WHEN 2 THEN 'Tuesday'  WHEN 3 THEN 'Wednesday'
          WHEN 4 THEN 'Thursday'  WHEN 5 THEN 'Friday'   WHEN 6 THEN 'Saturday'
          WHEN 7 THEN 'Sunday'
        END AS DayOfWeekName
      FROM ontime
      GROUP BY DayOfWeek
    ]]></SQL>
  </View>

  <View alias="dim_origin_airport">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT
        toString(Origin)   AS AirportCode,
        OriginCityName     AS CityName,
        OriginStateName    AS StateName
      FROM ontime
      GROUP BY Origin, OriginCityName, OriginStateName
    ]]></SQL>
  </View>

  <View alias="dim_dest_airport">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT
        toString(Dest)   AS AirportCode,
        DestCityName     AS CityName,
        DestStateName    AS StateName
      FROM ontime
      GROUP BY Dest, DestCityName, DestStateName
    ]]></SQL>
  </View>

  <View alias="dim_distance_group">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT
        toUInt8(DistanceGroup) AS DistanceGroupKey,
        CASE toUInt8(DistanceGroup)
          WHEN 1  THEN 'Less than 250 mi'  WHEN 2  THEN '250-499 mi'
          WHEN 3  THEN '500-749 mi'        WHEN 4  THEN '750-999 mi'
          WHEN 5  THEN '1000-1249 mi'      WHEN 6  THEN '1250-1499 mi'
          WHEN 7  THEN '1500-1749 mi'      WHEN 8  THEN '1750-1999 mi'
          WHEN 9  THEN '2000-2249 mi'      WHEN 10 THEN '2250-2499 mi'
          WHEN 11 THEN '2500 mi and more'
        END AS DistanceGroupName
      FROM ontime
      GROUP BY toUInt8(DistanceGroup)
    ]]></SQL>
  </View>

  <View alias="dim_tail">
    <SQL dialect="clickhouse"><![CDATA[
      SELECT Tail_Number
      FROM ontime
      WHERE match(Tail_Number, '^[A-Za-z0-9@\-/#?]*$')
      GROUP BY Tail_Number
    ]]></SQL>
  </View>

  <Cube name="OnTime (attributes)" cache="true" enabled="true">

    <View alias="fact">
      <SQL dialect="clickhouse"><![CDATA[
        SELECT
          Year * 100 + Month                       AS YearMonth,
          Year,
          Quarter,
          Month,
          DayOfWeek,
          Reporting_Airline,
          toString(Origin)                         AS OriginCode,
          toString(Dest)                           AS DestCode,
          toUInt8(DistanceGroup)                   AS DistanceGroupKey,
          Tail_Number,
          Flights,
          DepDelayMinutes,
          ArrDelayMinutes,
          ArrDel15,
          Cancelled,
          Diverted
        FROM ontime
      ]]></SQL>
    </View>

    <Dimension name="Airline" foreignKey="Reporting_Airline"
               table="dim_airline" primaryKey="Reporting_Airline">

      <!-- AttributeMapping must precede DimensionAttribute/Hierarchy: CubeDimension's
           children are parsed positionally. See context/native_query.md §10. -->
      <AttributeMapping attribute="Airline" factColumn="Reporting_Airline"/>

      <DimensionAttribute name="Airline" estimatedCount="33">
        <KeyColumn columnName="Reporting_Airline" dataType="String"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Airlines">
        <Level name="Airline" approxRowCount="33" uniqueMembers="true" sourceAttribute="Airline"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Time" type="TimeDimension" foreignKey="YearMonth"
               table="dim_time" primaryKey="YearMonth">

      <AttributeMapping attribute="Year"    factColumn="Year"/>
      <AttributeMapping attribute="Quarter" factColumn="Quarter"/>
      <AttributeMapping attribute="Month"   factColumn="Month"/>

      <DimensionAttribute name="Year" estimatedCount="30" levelType="TimeYears">
        <KeyColumn columnName="Year" dataType="Numeric"/>
      </DimensionAttribute>

      <DimensionAttribute name="Quarter" estimatedCount="4" levelType="TimeQuarters">
        <KeyColumn columnName="Quarter" dataType="Numeric"/>
        <NameColumn dataType="String" columnName="QuarterName"/>
      </DimensionAttribute>

      <DimensionAttribute name="Month" estimatedCount="12" levelType="TimeMonths">
        <KeyColumn columnName="Month" dataType="Numeric"/>
        <NameColumn dataType="String" columnName="MonthName"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Time">
        <Level name="Year"    approxRowCount="30"  uniqueMembers="true"  levelType="TimeYears"    sourceAttribute="Year"/>
        <Level name="Quarter" approxRowCount="116" uniqueMembers="false" levelType="TimeQuarters" sourceAttribute="Quarter" nameColumn="QuarterName"/>
        <Level name="Month"   approxRowCount="346" uniqueMembers="false" levelType="TimeMonths"   sourceAttribute="Month"   nameColumn="MonthName"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Day of Week" foreignKey="DayOfWeek"
               table="dim_day_of_week" primaryKey="DayOfWeekKey">

      <AttributeMapping attribute="Day of Week" factColumn="DayOfWeek"/>

      <DimensionAttribute name="Day of Week" estimatedCount="7">
        <KeyColumn columnName="DayOfWeekKey" dataType="Numeric"/>
        <NameColumn dataType="String" columnName="DayOfWeekName"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Days">
        <Level name="Day of Week" approxRowCount="7" uniqueMembers="true" sourceAttribute="Day of Week" nameColumn="DayOfWeekName"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Origin Airport" foreignKey="OriginCode"
               table="dim_origin_airport" primaryKey="AirportCode">

      <!-- Deliberately NOT mapped, though the fact view carries OriginCode.
           dim_origin_airport groups by (Origin, OriginCityName, OriginStateName), and 6 codes
           (SJU, STT, STX, GUM, USA, SPN) carry two city/state spellings, so AirportCode is not
           unique in the view and the fact->dim join fans out. Skipping that join via a
           factColumn would silently change results (for 2022: 6,767,533 -> 6,729,125 Flights).
           Fix the view's key first; only then is a mapping safe.
           Origin City / Origin State are absent from the fact view entirely. -->

      <DimensionAttribute name="Origin State" estimatedCount="54">
        <KeyColumn columnName="StateName" dataType="String"/>
      </DimensionAttribute>

      <DimensionAttribute name="Origin City" estimatedCount="426">
        <KeyColumn columnName="CityName" dataType="String"/>
      </DimensionAttribute>

      <DimensionAttribute name="Origin Airport" estimatedCount="435">
        <KeyColumn columnName="AirportCode" dataType="String"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Origins">
        <Level name="State"   approxRowCount="54"  uniqueMembers="true"  sourceAttribute="Origin State"/>
        <Level name="City"    approxRowCount="426" uniqueMembers="false" sourceAttribute="Origin City"/>
        <Level name="Airport" approxRowCount="435" uniqueMembers="true"  sourceAttribute="Origin Airport"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Destination Airport" foreignKey="DestCode"
               table="dim_dest_airport" primaryKey="AirportCode">

      <!-- Deliberately NOT mapped, for the same reason as Origin Airport above: the same 6
           codes carry two city/state spellings, so AirportCode is not unique in
           dim_dest_airport. Dest City / Dest State are absent from the fact view. -->

      <DimensionAttribute name="Dest State" estimatedCount="54">
        <KeyColumn columnName="StateName" dataType="String"/>
      </DimensionAttribute>

      <DimensionAttribute name="Dest City" estimatedCount="425">
        <KeyColumn columnName="CityName" dataType="String"/>
      </DimensionAttribute>

      <DimensionAttribute name="Dest Airport" estimatedCount="436">
        <KeyColumn columnName="AirportCode" dataType="String"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Destinations">
        <Level name="State"   approxRowCount="54"  uniqueMembers="true"  sourceAttribute="Dest State"/>
        <Level name="City"    approxRowCount="425" uniqueMembers="false" sourceAttribute="Dest City"/>
        <Level name="Airport" approxRowCount="436" uniqueMembers="true"  sourceAttribute="Dest Airport"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Distance Group" foreignKey="DistanceGroupKey"
               table="dim_distance_group" primaryKey="DistanceGroupKey">

      <AttributeMapping attribute="Distance Group" factColumn="DistanceGroupKey"/>

      <DimensionAttribute name="Distance Group" estimatedCount="11">
        <KeyColumn columnName="DistanceGroupKey" dataType="Numeric"/>
        <NameColumn dataType="String" columnName="DistanceGroupName"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Distances">
        <Level name="Distance Group" approxRowCount="11" uniqueMembers="true" sourceAttribute="Distance Group" nameColumn="DistanceGroupName"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Tail Number" foreignKey="Tail_Number"
               table="dim_tail" primaryKey="Tail_Number">

      <!-- Deliberately NOT mapped, though the fact view carries Tail_Number. dim_tail is a
           *filtered* projection (WHERE match(...)), excluding 2,275 tail numbers / 2,881,129
           Flights that the fact table still holds. A factColumn skips the join and so stops
           applying that filter, which would silently change results. -->

      <DimensionAttribute name="Tail Number" estimatedCount="17180">
        <KeyColumn columnName="Tail_Number" dataType="String"/>
      </DimensionAttribute>

      <Hierarchy hasAll="true" allMemberName="All Tails">
        <Level name="Tail Number" approxRowCount="17180" uniqueMembers="true" sourceAttribute="Tail Number"/>
      </Hierarchy>
    </Dimension>

    <Measure name="Flights"    column="Flights"   aggregator="sum" formatString="#,##0"/>
    <Measure name="Cancelled"  column="Cancelled" aggregator="sum" formatString="#,##0"/>
    <Measure name="Diverted"   column="Diverted"  aggregator="sum" formatString="#,##0"/>

    <Measure name="Late Arrivals" column="ArrDel15" aggregator="sum" formatString="#,##0"/>

    <Measure name="Total Arr Delay" column="ArrDelayMinutes" aggregator="sum" visible="false"/>
    <Measure name="Total Dep Delay" column="DepDelayMinutes" aggregator="sum" visible="false"/>

    <Measure name="Distinct Tail Numbers" column="Tail_Number" aggregator="distinct-count" formatString="#,##0"/>

    <CalculatedMember name="Avg Arr Delay" dimension="Measures" formatString="#,##0.00">
      <Formula>[Measures].[Total Arr Delay] / [Measures].[Flights]</Formula>
    </CalculatedMember>

    <CalculatedMember name="Avg Dep Delay" dimension="Measures" formatString="#,##0.00">
      <Formula>[Measures].[Total Dep Delay] / [Measures].[Flights]</Formula>
    </CalculatedMember>

    <CalculatedMember name="Cancellation Rate" dimension="Measures" formatString="0.00%">
      <Formula>[Measures].[Cancelled] / [Measures].[Flights]</Formula>
    </CalculatedMember>

    <CalculatedMember name="Diversion Rate" dimension="Measures" formatString="0.00%">
      <Formula>[Measures].[Diverted] / [Measures].[Flights]</Formula>
    </CalculatedMember>

    <CalculatedMember name="Delay Rate" dimension="Measures" formatString="0.00%">
      <Formula>[Measures].[Late Arrivals] / [Measures].[Flights]</Formula>
    </CalculatedMember>

    <CalculatedMember name="On-Time Rate" dimension="Measures" formatString="0.00%">
      <Formula>IIf(IsEmpty([Measures].[Flights]) OR [Measures].[Flights] = 0, NULL, 1 - ([Measures].[Late Arrivals] + [Measures].[Cancelled] + [Measures].[Diverted]) / [Measures].[Flights])</Formula>
    </CalculatedMember>

  </Cube>
</Schema>
